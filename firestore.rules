rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAuthority() {
      return userExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['authority', 'municipal_officer', 'admin'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAuthority();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role in ['citizen', 'municipal_officer', 'authority'] || !('role' in request.resource.data));
      allow update: if isOwner(userId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'clearanceLevel'])
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAuthority() || (
        isOwner(resource.data.reporterId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'escrowStatus', 'disbursedAmount', 'contractorId', 'contractorName', 'payoutAmount', 'assignedDepartment', 'reporterId'
        ])
      );
      allow delete: if isAdmin() || (isOwner(resource.data.reporterId) && resource.data.status == 'submitted');

      match /supporters/{supporterUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && supporterUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/reports/$(reportId));
        allow update: if false;
        allow delete: if isAdmin() || supporterUid == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /repair_updates/{updateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isAdmin() || isAuthority();
      allow delete: if isAdmin();
    }
  }
}
